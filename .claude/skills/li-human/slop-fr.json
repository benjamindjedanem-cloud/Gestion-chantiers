  "structures": [
    {
      "id": "pas-seulement",
      "regex": "(?i)\\bce n'?est pas (?:seulement|juste|qu'?un[e]?) [^.!?\\n]{2,60}[,.] c'?est\\b",
      "name": "« Ce n'est pas seulement X, c'est Y »",
      "fix": "Dis la seule chose que tu veux dire. Supprime la première moitié."
    },
    {
      "id": "non-seulement",
      "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également)\\b",
      "name": "« Non seulement X mais aussi Y »",
      "fix": "Coupe en deux phrases, ou garde la plus forte."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b(\\w+), (\\w+) et (\\w+)\\b",
      "name": "Énumération en trois (règle de trois)",
      "fix": "Garde deux éléments, ou un seul, précis."
    },
    {
      "id": "hashtags",
      "regex": "(?:#\\w+\\s*){4,}",
      "name": "Mur de hashtags",
      "fix": "Trois hashtags maximum, ou aucun."
    },
    {
      "id": "appat",
      "regex": "(?i)\\b(likez|commentez|partagez) (?:si|pour)\\b",
      "name": "Appât à engagement",
      "fix": "Supprime. Pose plutôt une vraie question précise."
    },
    {
      "id": "nhesitez",
      "regex": "(?i)\\bn'?h[ée]sit(?:ez|e) pas\\b",
      "name": "« N'hésitez pas à… »",
      "fix": "Remplace par l'action directe : « Écrivez-nous. »"
    },
    {
      "id": "qu-en-pensez",
      "regex": "(?i)\\bqu'?en pens(?:ez|es)[- ](?:vous|tu)\\s*\\?",
      "name": "« Qu'en pensez-vous ? » en fin de post",
      "fix": "Pose une question précise que seul ce post peut poser, ou termine sur la chute."
    }
  ],
  "contractions_regex": "\\b(?:j|t|c|qu|n|l|d|s)'\\w+",
  "pronouns_regex": "\\b(je|j'|moi|mon|ma|mes|nous|notre|nos|tu|toi|ton|ta|tes|vous|votre|vos)\\b"
